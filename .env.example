# Copy this file to .env (local) or enter these in your hosting provider's
# environment-variable settings, then rebuild. NEVER commit a real .env.
#
# Target Supabase project: juice-menu-faisel-st
# Dashboard -> Project Settings -> API (or "API Keys"):
#   Project URL      -> VITE_SUPABASE_URL
#   Publishable key  -> VITE_SUPABASE_PUBLISHABLE_KEY   (sb_publishable_...)
# Only the publishable (or legacy "anon") key ever goes here. NEVER put a
# secret / service_role key in any VITE_* variable - they are shipped to browsers.

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>

# Optional production origin used in QR / printed order links, e.g. https://menu.example.com
VITE_PUBLIC_APP_URL=
